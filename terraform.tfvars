edu_snowflake_default_file_formats = [
    {
        database           = "raw"
        schema             = "public"
        name               = "json_default"
        format_type        = "json"
        binary_format      = "utf-8"
        compression        = "auto"
        enable_octal       = false
        allow_duplicate    = false
        strip_outer_array  = false 
        strip_null_values  = true 
        ignore_utf8_errors = false
    },
    {
        database           = "dev_raw"
        schema             = "public"
        name               = "json_default"
        format_type        = "json"
        binary_format      = "utf-8"
        compression        = "auto"
        enable_octal       = false
        allow_duplicate    = false
        strip_outer_array  = false 
        strip_null_values  = true 
        ignore_utf8_errors = false
    },
]

# Warehouses in snowflake are compute units. We set default warehouses for loading and
# transforming x prod and dev environments, plus an ad-hoc querying warehouse.
edu_snowflake_default_warehouses = [
    {
        name                = "ea_ad_hoc"
        size                = "xsmall"
        auto_suspend        = 60
        auto_resume         = true
        initially_suspended = true
        comment             = "Ad-hoc queries for EA staff"
    },
    {
        name                = "loading_prod"
        size                = "small"
        auto_suspend        = 60
        auto_resume         = true
        initially_suspended = true
        comment             = "Loading production raw data"
    },
    {
        name                = "transforming_prod"
        size                = "medium"
        auto_suspend        = 60
        auto_resume         = true
        initially_suspended = true
        comment             = "Transforming production raw data"
    },
    {
        name                = "loading_dev"
        size                = "small"
        auto_suspend        = 60
        auto_resume         = true
        initially_suspended = true
        comment             = "Loading dev raw data"
    },
    {
        name                = "transforming_dev"
        size                = "medium"
        auto_suspend        = 60
        auto_resume         = true
        initially_suspended = true
        comment             = "Transforming dev data"
    },
]

