# In `configuration.tfvars` you can specify human and service snowflake_user accounts.
# Below are default service accounts for Airflow to load and transform data.
edu_snowflake_default_users = [
    {
        name              = "loader_airflow_prod"
        default_warehouse = "loading_prod"
        default_namespace = "raw"
        default_role      = "loader_prod"
        comment           = "Production Airflow user"
    },
    {
        name              = "loader_airflow_dev"
        default_warehouse = "loading_dev"
        default_namespace = "dev_raw"
        default_role      = "loader_dev"
        comment           = "Development Airflow user"
    },
    {
        name              = "transformer_dbt_prod"
        default_warehouse = "transforming_prod"
        default_namespace = "analytics"
        default_role      = "transformer_prod"
        comment           = "Production dbt user"
    },
    {
        name              = "transformer_dbt_dev"
        default_warehouse = "transforming_dev"
        default_namespace = "dev_analytics"
        default_role      = "transformer_dev"
        comment           = "Development dbt user"
    }
]

