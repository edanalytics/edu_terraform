    # Grant access roles to functional roles
    {
        role_names      = [ "db_raw_rw" ] # to
        to_object_type  = "ROLE"
        to_object_names = [ "loader_prod" ]
    },
    {
        role_names      = [ "db_dev_raw_rw" ] # to
        to_object_type  = "ROLE"
        to_object_names = [ "loader_dev" ]
    },
    {
