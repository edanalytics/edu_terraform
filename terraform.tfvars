    },
    {
        role_names      = [ "db_dev_analytics_rw" ] # to
        to_object_type  = "ROLE"
        to_object_names = [ "transformer_dev" ]
    },
    # note: transformer_dev can read from prod raw data, but can't write to prod analytics
    {
        role_names      = [ "db_raw_r" ] # to
        to_object_type  = "ROLE"
        to_object_names = [ "transformer_dev" ]
    },
    {
        role_names      = [ "db_raw_r" ] # to
