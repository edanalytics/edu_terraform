# Default databases for raw data and analytics x prod and dev environments.
edu_snowflake_default_databases = [
    {
        name    = "raw"
        comment = "Production raw data"
    },
    {
        name    = "dev_raw"
        comment = "Development raw data"
    },
    {
        name    = "analytics"
        comment = "Production analytics data"
    },
    {
        name    = "dev_analytics"
        comment = "Development analytics data"
    },
]

edu_snowflake_default_schemas = [
    {
        database = "raw"
        name     = "edfi3"
        comment  = "Raw data from Ed-Fi Suite 3 systems"
    },
    {
        database = "dev_raw"
        name     = "edfi3"
        comment  = "Raw data from Ed-Fi Suite 3 systems"
    },
    # schemas to hold stages
    {
        database = "raw"
        name     = "util"
        comment  = ""
    },
    {
        database = "dev_raw"
        name     = "util"
        comment  = ""
    }
]

